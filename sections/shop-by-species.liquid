{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .species-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media screen and (min-width: 750px) {
    .species-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .species-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .species-card {
    display: block;
    text-decoration: none;
    color: currentColor;
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(11, 42, 69, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .species-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px rgba(11, 42, 69, 0.18);
    border-color: rgb(var(--color-button));
  }

  .species-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(160deg, #eaf3f7 0%, #d6e6ee 100%);
  }

  .species-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .species-card:hover .species-card__media img {
    transform: scale(1.06);
  }

  /* soft inner vignette + bottom fade unifies the mismatched source photos */
  .species-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 24px rgba(11, 42, 69, 0.12);
    background: linear-gradient(to bottom, rgba(11, 42, 69, 0) 62%, rgba(11, 42, 69, 0.14) 100%);
  }

  .species-card__illustration {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20%;
  }

  .species-card__illustration svg {
    width: 100%;
    height: 100%;
  }

  .species-card__body {
    padding: 0.85rem 0.9rem 1rem;
  }

  .species-card__label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .species-card__price {
    display: inline-block;
    font-size: 0.78rem;
    color: rgb(var(--color-button));
    background: rgba(var(--color-button), 0.12);
    font-weight: 700;
    margin-top: 0.4rem;
    padding: 0.2rem 0.6rem;
    border-radius: 40px;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      </div>
    {%- endunless -%}

    <div class="species-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          case block.settings.icon
            when 'salmon'
              assign body_fill = '#E3A94B'
              assign fin_fill = '#C9A227'
              assign eye_fill = '#0B2A45'
              assign gill_color = '#0B2A45'
            when 'tuna'
              assign body_fill = '#2AA79C'
              assign fin_fill = '#C9A227'
              assign eye_fill = '#FFFFFF'
              assign gill_color = '#0B2A45'
            when 'branzino'
              assign body_fill = '#CFE3EA'
              assign fin_fill = '#0B2A45'
              assign eye_fill = '#0B2A45'
              assign gill_color = '#0B2A45'
            when 'snapper'
              assign body_fill = '#C1512F'
              assign fin_fill = '#8F3A20'
              assign eye_fill = '#FFFFFF'
              assign gill_color = '#FFFFFF'
            when 'whitefish'
              assign body_fill = '#EEF4F8'
              assign fin_fill = '#0B2A45'
              assign eye_fill = '#0B2A45'
              assign gill_color = '#0B2A45'
            else
              assign body_fill = '#0B2A45'
              assign fin_fill = '#0B2A45'
              assign eye_fill = '#FFFFFF'
              assign gill_color = '#FFFFFF'
          endcase
        -%}
        {%- liquid
          assign photo_asset = blank
          case block.settings.icon
            when 'salmon-photo'
              assign photo_asset = 'species-salmon.jpg'
            when 'tuna-photo'
              assign photo_asset = 'species-tuna.jpg'
            when 'branzino-photo'
              assign photo_asset = 'species-branzino.jpg'
            when 'snapper-photo'
              assign photo_asset = 'species-snapper.webp'
            when 'whitefish-photo'
              assign photo_asset = 'species-cod.webp'
            when 'grouper-photo'
              assign photo_asset = 'species-grouper.webp'
            when 'flounder-photo'
              assign photo_asset = 'species-flounder.webp'
            when 'halibut-photo'
              assign photo_asset = 'species-halibut.webp'
            when 'whiting-photo'
              assign photo_asset = 'species-whiting.webp'
            when 'tilefish-photo'
              assign photo_asset = 'species-tilefish.webp'
            when 'mullet-photo'
              assign photo_asset = 'species-mullet.webp'
            when 'buffalofish-photo'
              assign photo_asset = 'species-buffalofish.webp'
            when 'carp-photo'
              assign photo_asset = 'species-carp.webp'
            when 'dorado-photo'
              assign photo_asset = 'species-dorado.webp'
            when 'tilapia-photo'
              assign photo_asset = 'species-tilapia.webp'
            when 'graysole-photo'
              assign photo_asset = 'species-graysole.webp'
          endcase
        -%}
        <a href="{{ block.settings.link | default: '#' }}" class="species-card" {{ block.shopify_attributes }}>
          <div class="species-card__media">
            {%- if photo_asset != blank -%}
              <img
                src="{{ photo_asset | asset_url }}"
                alt="{{ block.settings.label | escape }}"
                loading="lazy"
                width="400"
                height="300"
              >
            {%- else -%}
              <div class="species-card__illustration">
                <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M82 30 L96 16 L86 38 L96 60 L82 46 Z" fill="{{ fin_fill }}"/>
                  <path d="M6 38 C6 24 26 16 50 16 C68 16 80 26 84 38 C80 50 68 60 50 60 C26 60 6 52 6 38 Z" fill="{{ body_fill }}" stroke="{{ fin_fill }}" stroke-width="1" stroke-opacity="0.25"/>
                  <path d="M40 17 L47 5 L55 17 Z" fill="{{ fin_fill }}"/>
                  <path d="M32 42 L25 54 L39 46 Z" fill="{{ fin_fill }}"/>
                  <path d="M34 18 C30 28 30 48 34 58" stroke="{{ gill_color }}" stroke-width="2" fill="none" opacity="0.5"/>
                  <circle cx="20" cy="30" r="3" fill="{{ eye_fill }}"/>
                </svg>
              </div>
            {%- endif -%}
          </div>
          <div class="species-card__body">
            <div class="species-card__label">{{ block.settings.label }}</div>
            {%- if section.settings.show_price -%}
              <div class="species-card__price">{{ section.settings.price_label }}</div>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Species cards",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Every fish is whole, $9.99/lb",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": true,
      "label": "Show price under each type"
    },
    {
      "type": "text",
      "id": "price_label",
      "default": "$9.99/lb",
      "label": "Price label"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "species",
      "name": "Type",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Salmon",
          "label": "Label"
        },
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "fish", "label": "Whole fish (generic)" },
            { "value": "salmon", "label": "Salmon (illustration)" },
            { "value": "salmon-photo", "label": "Salmon (real photo)" },
            { "value": "tuna", "label": "Tuna (illustration)" },
            { "value": "tuna-photo", "label": "Tuna (real photo)" },
            { "value": "branzino", "label": "Branzino (illustration)" },
            { "value": "branzino-photo", "label": "Branzino (real photo)" },
            { "value": "snapper", "label": "Red snapper (illustration)" },
            { "value": "snapper-photo", "label": "Red snapper (real photo)" },
            { "value": "whitefish", "label": "Whitefish - halibut, cod, etc. (illustration)" },
            { "value": "whitefish-photo", "label": "Whitefish - cod (real photo)" },
            { "value": "grouper-photo", "label": "Grouper (real photo)" },
            { "value": "flounder-photo", "label": "Flounder (real photo)" },
            { "value": "halibut-photo", "label": "Halibut (real photo)" },
            { "value": "whiting-photo", "label": "Whiting (real photo)" },
            { "value": "tilefish-photo", "label": "Tile fish (real photo)" },
            { "value": "mullet-photo", "label": "Mullet (real photo)" },
            { "value": "buffalofish-photo", "label": "Buffalo fish (real photo)" },
            { "value": "carp-photo", "label": "Carp (real photo)" },
            { "value": "dorado-photo", "label": "Dorado (real photo)" },
            { "value": "tilapia-photo", "label": "Tilapia (real photo)" },
            { "value": "graysole-photo", "label": "Gray sole (real photo)" }
          ],
          "default": "fish",
          "label": "Icon"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Species cards",
      "blocks": [
        { "type": "species", "settings": { "label": "Salmon", "icon": "salmon-photo" } },
        { "type": "species", "settings": { "label": "Tuna", "icon": "tuna-photo" } },
        { "type": "species", "settings": { "label": "Branzino", "icon": "branzino-photo" } },
        { "type": "species", "settings": { "label": "Red Snapper", "icon": "snapper-photo" } }
      ]
    }
  ]
}
{% endschema %}
