{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .species-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media screen and (min-width: 750px) {
    .species-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .species-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .species-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: currentColor;
    text-align: center;
  }

  .species-card__icon {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(var(--color-foreground), 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22%;
  }

  .species-card__icon svg {
    width: 100%;
    height: 100%;
  }

  .species-card__icon--photo {
    padding: 0;
    overflow: hidden;
  }

  .species-card__icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .species-card__label {
    font-weight: 600;
  }

  .species-card__price {
    font-size: 0.8rem;
    color: rgb(var(--color-button));
    font-weight: 600;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      </div>
    {%- endunless -%}

    <div class="species-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          case block.settings.icon
            when 'salmon'
              assign body_fill = '#E3A94B'
              assign fin_fill = '#C9A227'
              assign eye_fill = '#0B2A45'
              assign gill_color = '#0B2A45'
            when 'tuna'
              assign body_fill = '#2AA79C'
              assign fin_fill = '#C9A227'
              assign eye_fill = '#FFFFFF'
              assign gill_color = '#0B2A45'
            when 'branzino'
              assign body_fill = '#CFE3EA'
              assign fin_fill = '#0B2A45'
              assign eye_fill = '#0B2A45'
              assign gill_color = '#0B2A45'
            when 'snapper'
              assign body_fill = '#C1512F'
              assign fin_fill = '#8F3A20'
              assign eye_fill = '#FFFFFF'
              assign gill_color = '#FFFFFF'
            when 'whitefish'
              assign body_fill = '#EEF4F8'
              assign fin_fill = '#0B2A45'
              assign eye_fill = '#0B2A45'
              assign gill_color = '#0B2A45'
            else
              assign body_fill = '#0B2A45'
              assign fin_fill = '#0B2A45'
              assign eye_fill = '#FFFFFF'
              assign gill_color = '#FFFFFF'
          endcase
        -%}
        {%- liquid
          assign photo_asset = blank
          case block.settings.icon
            when 'salmon-photo'
              assign photo_asset = 'species-salmon.webp'
            when 'tuna-photo'
              assign photo_asset = 'species-tuna.jpg'
          endcase
        -%}
        <a href="{{ block.settings.link | default: '#' }}" class="species-card" {{ block.shopify_attributes }}>
          <span class="species-card__icon{% if photo_asset != blank %} species-card__icon--photo{% endif %}">
            {%- if photo_asset != blank -%}
              <img
                src="{{ photo_asset | asset_url }}"
                alt="{{ block.settings.label | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {%- else -%}
              <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M82 30 L96 16 L86 38 L96 60 L82 46 Z" fill="{{ fin_fill }}"/>
                <path d="M6 38 C6 24 26 16 50 16 C68 16 80 26 84 38 C80 50 68 60 50 60 C26 60 6 52 6 38 Z" fill="{{ body_fill }}" stroke="{{ fin_fill }}" stroke-width="1" stroke-opacity="0.25"/>
                <path d="M40 17 L47 5 L55 17 Z" fill="{{ fin_fill }}"/>
                <path d="M32 42 L25 54 L39 46 Z" fill="{{ fin_fill }}"/>
                <path d="M34 18 C30 28 30 48 34 58" stroke="{{ gill_color }}" stroke-width="2" fill="none" opacity="0.5"/>
                <circle cx="20" cy="30" r="3" fill="{{ eye_fill }}"/>
              </svg>
            {%- endif -%}
          </span>
          <span class="species-card__label">{{ block.settings.label }}</span>
          {%- if section.settings.show_price -%}
            <span class="species-card__price">{{ section.settings.price_label }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by type",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Shop by type",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": true,
      "label": "Show price under each type"
    },
    {
      "type": "text",
      "id": "price_label",
      "default": "$9.99/lb",
      "label": "Price label"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "species",
      "name": "Type",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Salmon",
          "label": "Label"
        },
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "fish", "label": "Whole fish (generic)" },
            { "value": "salmon", "label": "Salmon (illustration)" },
            { "value": "salmon-photo", "label": "Salmon (real photo)" },
            { "value": "tuna", "label": "Tuna (illustration)" },
            { "value": "tuna-photo", "label": "Tuna (real photo)" },
            { "value": "branzino", "label": "Branzino" },
            { "value": "snapper", "label": "Red snapper" },
            { "value": "whitefish", "label": "Whitefish (halibut, cod, etc.)" }
          ],
          "default": "fish",
          "label": "Icon"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by type",
      "blocks": [
        { "type": "species", "settings": { "label": "Salmon", "icon": "salmon" } },
        { "type": "species", "settings": { "label": "Tuna", "icon": "tuna" } },
        { "type": "species", "settings": { "label": "Branzino", "icon": "branzino" } },
        { "type": "species", "settings": { "label": "Red Snapper", "icon": "snapper" } }
      ]
    }
  ]
}
{% endschema %}
